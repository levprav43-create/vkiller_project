# =============================================================================
# VKINDER BOT - Пример конфигурации (.env.example)
# =============================================================================
# Скопируй этот файл в .env и заполни своими значениями!
# ВАЖНО: Файл .env НЕ должен попадать в репозиторий (добавлен в .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# VK API настройки
# -----------------------------------------------------------------------------
# Токен пользователя (получить: https://vkhost.github.io/ → Kate Mobile → Все права)
# ИЛИ токен группы (если бот работает в сообщениях сообщества)
VK_TOKEN=your_vk_token_here

# Версия VK API (не менять)
VK_VERSION=5.131

# ID группы ВКонтакте (без минуса, например: 236578249)
# Узнать ID группы: https://reg.ru/whois/admin.html (ввести ссылку на группу)
VK_GROUP_ID=your_group_id_here

# -----------------------------------------------------------------------------
# PostgreSQL настройки
# -----------------------------------------------------------------------------
# Пользователь БД (по умолчанию: postgres)
DB_USER=postgres

# Пароль пользователя БД (укажи свой реальный пароль)
DB_PASSWORD=your_database_password_here

# Хост БД (localhost если БД на этом же компьютере)
DB_HOST=localhost

# Порт PostgreSQL (по умолчанию: 5432)
DB_PORT=5432

# Имя базы данных
DB_NAME=vkiller_db

# -----------------------------------------------------------------------------
# Настройки бота
# -----------------------------------------------------------------------------
# Префикс команд (обычно /)
BOT_PREFIX=/